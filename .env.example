APP_NAME=公众号内容工作台
API_PREFIX=/api
DEBUG=true
DB_PATH=C:/tmp/gankaigc-wechat-workbench.db
GENERATED_ASSETS_DIR=C:/tmp/gankaigc-wechat-workbench-assets
WECHAT_MP_SESSION_PATH=C:/tmp/gankaigc-wechat-workbench-wechat-session.json
WECHAT_MP_REQUEST_TIMEOUT_SECONDS=15
WX_CHANNEL_API_BASE_URL=http://127.0.0.1:2026
WX_CHANNEL_REQUEST_TIMEOUT_SECONDS=15
TREND_FEED_URLS=["https://example.com/feed.xml"]
TREND_FETCH_REQUEST_TIMEOUT_SECONDS=15
TREND_FETCH_MAX_ITEMS_PER_FEED=10
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRUST_ENV=false
OPENAI_REASONING_EFFORT=medium
OPENAI_CREATIVE_QUALITY_RETRY_MAX_ATTEMPTS=1
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_REQUEST_TIMEOUT_SECONDS=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_GENERATION_MAX_ATTEMPTS=1
OPENAI_IMAGE_FALLBACK_API_KEY=
OPENAI_IMAGE_FALLBACK_BASE_URL=
OPENAI_IMAGE_FALLBACK_REQUEST_TIMEOUT_SECONDS=
OPENAI_IMAGE_FALLBACK_MODEL=
